{
  "analysis_rules": {
    "branch_rule": "冻结 §3 字面：V1∧V2 ⇒ B-CLOCK-CONFIRMED；V1 全过∧V2 破 ⇒ B-COUNTER-OTHER；V1 破但 6 token 定长同格式 ⇒ B-COUNTER-OTHER；否则 ⇒ B-INDETERMINATE / exit2",
    "byte_class_definition": "digit=ASCII 0-9；alpha=ASCII A-Z/a-z；other=其余全部字节（含 UTF-8 多字节序列、标点等）；bof=run 起点为文本首（无左邻，结构性取值）",
    "envelope_definition": "信封=W1 冻结开/闭标记的精确 span（标记字面以环 11 包 analysis_rules 同名定义为准，此处不重复登记标记文本）",
    "fail_closed_scope": "预注册封印不符、双硬等（offsets/run 边界）失败、档案布局异常、trace/消息结构异常、时区偏移不一致或缺失、信封 span 数≠1 或与环 11 不符、孤立位非单数字、token 非 5 ASCII 字节 ⇒ exit2 / B-INDETERMINATE",
    "fixed_format_definition": "定长同格式 = 6 token 字节长度集合单值 ∧ 逐位置字节类序列全体相等 ∧ 分隔字节值全体相等",
    "rel_position_definition": "rel_position = offset − 信封闭合（envelope span 终点）",
    "run_definition": "极大数字 run=文本中 byte_class==digit 的极大连续段 [起,止)；逐 offset×rep 独立计算",
    "token_definition": "见 tokens.rule；token 字节含非 ASCII 即 fail-closed（值发布边界：只发布 4 数字+1 分隔的 5 字节值）",
    "v1_rule": "V1 = 全部 6 token 匹配 ^([01]\\d|2[0-3]):[0-5]\\d$ 且分隔字节值 6/6 同一",
    "v2_rule": "V2 = 逐 rep：token 的 HH:MM 与该 run 首消息 HH:MM 的 naive 分钟差 |Δ|≤1（逐 rep 登记 signed Δ、|Δ|、午夜循环差、方向窗 [-1,+5]min 布尔）；token 不满足 HH:MM 文法时 v2_evaluable=false、Δ=null；V2_pass = 6/6 可评且全过",
    "v3_rule": "V3 = 孤立位（信封内 2 + 信封外 1，共 6 处）单数字字节值逐 rep 登记，不判语义；非单数字结构即 fail-closed",
    "value_publication_boundary": "值发布边界声明：本包读取 W1 提取文本与同 run 轨迹消息时间戳字段；发布仅限——漂移 token 的 5 字节值（4 数字+1 分隔）、分隔字节值、孤立位单数字字节值、消息时间戳的 HH:MM（分钟精度墙钟，秒/毫秒与日期不发布）、字段名与换算规则；字母序列/多字节序列/信封或任务正文任何切片零发布；结果不含私有档案绝对路径。"
  },
