  "analysis_rules": {
    "byte_class_definition": "digit=ASCII 0-9；alpha=ASCII A-Z/a-z；other=其余全部字节（含 UTF-8 多字节序列、标点等）；bof=run 起点为文本首（无左邻，结构性取值）",
    "cluster_caliper_disclosure": "『信封外簇』按勘察注记自身用法与环 11 簇定义取跨 case rel 对齐口径（DD?DD 群）；信封外孤立位（每 case 1 处）不属于簇、无 S 断言绑定但逐位登记。敏感性：若采『信封外簇=全部信封外漂移位』替代口径，信封外孤立位（run 长 1）将令 S1 破而翻为 B-SHAPE-VARIABLE；该口径差异如实披露，最终口径裁定权在预注册文本",
    "envelope_definition": "信封=W1 冻结开/闭标记的精确 span（标记字面以环 11 包 analysis_rules 同名定义为准，此处不重复登记标记文本）",
    "fail_closed_scope": "硬等失败、档案布局异常、trace/消息结构异常、rep 文本长度不等、信封 span 数≠1 或跨 rep 不等或与环 11 登记不符 ⇒ exit2 / B-INDETERMINATE（fail-closed）",
    "rel_position_definition": "rel_position = offset − 信封闭合（envelope span 终点）",
    "run_definition": "极大数字 run=文本中 byte_class==digit 的极大连续段 [起,止)；逐 offset×rep 独立计算",
    "value_independence_boundary": "分隔字节与漂移字节值一律不读不登记；跨 rep 只比较 run 边界（起/止/长），不比较任何字节值是否相同"
