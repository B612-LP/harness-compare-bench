{"type": "tool_call", "callId": "call_00_llqEFwjrUUHbL8ld4lin5204", "tool": "bash", "input": {"command": "cd /Users/b612-lp/bench-workspaces/r1030/dsh/lcb-recent-hard-4 && python3 - << 'PY'\nimport itertools, subprocess\nfrom collections import deque, Counter\n\ndef brute(N,P=10**9+7):\n    pairs=[(i,j) for i in range(N) for j in range(i+1,N)]\n    E=len(pairs)\n    cnt=Counter()\n    for mask in range(1<<E):\n        adj=[[] for _ in range(N)]\n        m=mask.bit_count()\n        for k,(i,j) in enumerate(pairs):\n            if mask>>k&1:\n                adj[i].append(j); adj[j].append(i)\n        # connected\n        seen=[False]*N; seen[0]=True; q=deque([0]); c=1\n        while q:\n            u=q.popleft()\n            for v in adj[u]:\n                if not seen[v]: seen[v]=True; c+=1; q.append(v)\n        if c<N: continue\n        dist=[-1]*N; dist[0]=0; q=deque([0])\n        while q:\n            u=q.popleft()\n            for v in adj[u]:\n                if dist[v]<0: dist[v]=dist[u]+1; q.append(v)\n        even=sum(d%2==0 for d in dist)\n        if even==N//2: cnt[m]+=1\n    return [cnt[m]%P for m in range(N-1,N*(N-1)//2+1)]\n\nfor N in [2,4,6]:\n    P=998244353\n    inp=f\"{N} {P}\\n\"\n    r=subprocess.run(['python3','solutions/abc389_g.py'],input=inp,text=True,capture_output=True)\n    got=list(map(int,r.stdout.split()))\n    exp=brute(N,P)\n    print(N,got,'OK' if got==exp else 'FAIL exp '+str(exp))\nPY", "description": "Brute test abc389_g N up to 6", "timeoutMs": 120000}}
