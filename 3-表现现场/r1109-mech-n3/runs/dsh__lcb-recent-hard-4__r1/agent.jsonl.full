{"type": "tool_result", "callId": "call_00_7TLh5cX0wez6k6bErkfN5842", "status": "completed", "result": "<path>/Users/b612-lp/bench-workspaces/r1030/dsh/lcb-recent-hard-4/solutions/abc387_f.py</path>\n<type>file</type>\n<content>\n1: import sys\n2: from collections import deque\n3: \n4: MOD = 998244353\n5: \n6: \n7: def main():\n8:     data = list(map(int, sys.stdin.buffer.read().split()))\n9:     if not data:\n10:         return\n11:     n, m = data[0], data[1]\n12:     a = [x - 1 for x in data[2:2 + n]]\n13: \n14:     # f[v][k] = number of ways in the subtree rooted at v (tree edges only)\n15:     # when x_v = k.  Index k runs from 0..m (0 is unused).\n16:     f = [[1] * (m + 1) for _ in range(n)]\n17:     indeg = [0] * n\n18:     for v in a:\n19:         indeg[v] += 1\n20: \n21:     q = deque(i for i in range(n) if indeg[i] == 0)\n22:     while q:\n23:         v = q.popleft()\n24:         fv = f[v]\n25:         pref = [0] * (m + 1)\n26:         s = 0\n27:         for k in range(1, m + 1):\n28:             s += fv[k]\n29:             if s >= MOD:\n30:                 s -= MOD\n31:             pref[k] = s\n32:         p = a[v]\n33:         fp = f[p]\n34:         for k in range(1, m + 1):\n35:             fp[k] = fp[k] * pref[k] % MOD\n36:         indeg[p] -= 1\n37:         if indeg[p] == 0:\n38:             q.append(p)\n39: \n40:     # Remaining vertices form directed cycles.\n41:     visited = [False] * n\n42:     ans = 1\n43:     for start in range(n):\n44:         if indeg[start] == 0 or visited[start]:\n45:             continue\n46:         cyc = []\n47:         v = start\n48:         while not visited[v]:\n49:             visited[v] = True\n50:             cyc.append(v)\n51:             v = a[v]\n52:         total = [0] * (m + 1)\n53:         for k in range(1, m + 1):\n54:             prod = 1\n55:             for u in cyc:\n56:                 prod = prod * f[u][k] % MOD\n57:             total[k] = prod\n58:         s = 0\n59:         for k in range(1, m + 1):\n60:             s += total[k]\n61:             if s >= MOD:\n62:                 s -= MOD\n63:         ans = ans * (s % MOD) % MOD\n64: \n65:     print(ans % MOD)\n66: \n67: \n68: if __name__ == \"__main__\":\n69:     main()\n\n(End of file - total 69 lines)\n</content>"}
{"type": "tool_result", "callId": "call_01_5GXpGMRXOMkYRRz1b4Ib0060", "status": "completed", "result": "<path>/Users/b612-lp/bench-workspaces/r1030/dsh/lcb-recent-hard-4/solutions/abc388_f.py</path>\n<type>file</type>\n<content>\n1: import sys\n2: \n3: \n4: def main():\n5:     data = list(map(int, sys.stdin.buffer.read().split()))\n6:     if not data:\n7:         return\n8:     n, m, A, B = data[0:4]\n9:     intervals = []\n10:     idx = 4\n11:     for _ in range(m):\n12:         L, R = data[idx], data[idx + 1]\n13:         idx += 2\n14:         intervals.append((L, R))\n15: \n16:     if A == B:\n17:         # The only possible move is +A.\n18:         if (n - 1) % A != 0:\n19:             print(\"No\")\n20:             return\n21:         # Every cell of the progression 1, 1+A, ... must be good.\n22:         for L, R in intervals:\n23:             # First number >= L congruent to 1 modulo A.\n24:             first = L + ((1 - L) % A)\n25:             if first <= R and first < n:\n26:                 print(\"No\")\n27:                 return\n28:         print(\"Yes\")\n29:         return\n30: \n31:     full = (1 << B) - 1\n32:     # Bits d-1 for A <= d <= B.\n33:     allowed = ((1 << (B - A + 1)) - 1) << (A - 1)\n34: \n35:     # mask bit j means: position (cur - j) is reachable.\n36:     # Initially cur = 1 and position 1 is reachable.\n37:     mask = 1\n38:     cur = 1\n39:     LIMIT = B * B + 5\n40: \n41:     def advance_good(length):\n42:         nonlocal mask\n43:         if length <= 0:\n44:             return\n45:         if mask == full:\n46:             return\n47:         if mask == 0:\n48:             return\n49:         steps = length if length < LIMIT else LIMIT\n50:         for _ in range(steps):\n51:             if mask == full:\n52:                 return\n53:             nb = 1 if (mask & allowed) else 0\n54:             mask = ((mask << 1) | nb) & full\n55:         # For A < B a non-empty mask becomes full within fewer than B^2 steps.\n56:         # The loop above therefore normally exits through the 'full' check;\n57:         # leaving it untouched here is still correct for any remaining steps\n58:         # because a full mask stays full.\n59: \n60:     def advance_bad(length):\n61:         nonlocal mask\n62:         if length <= 0 or mask == 0:\n63:             return\n64:         steps = length if length < B else B\n65:         for _ in range(steps):\n66:             mask = (mask << 1) & full\n67:         # After B shifts the mask is zero; any remaining bad cells keep it zero.\n68: \n69:     for L, R in intervals:\n70:         advance_good(L - cur - 1)\n71:         advance_bad(R - L + 1)\n72:         cur = R\n73: \n74:     advance_good(n - cur)\n75:     print(\"Yes\" if (mask & 1) else \"No\")\n76: \n77: \n78: if __name__ == \"__main__\":\n79:     main()\n\n(End of file - total 79 lines)\n</content>"}
{"type": "tool_result", "callId": "call_02_pASi7jSimFqNj7enwlgB6254", "status": "completed", "result": "<path>/Users/b612-lp/bench-workspaces/r1030/dsh/lcb-recent-hard-4/solutions/abc388_g.py</path>\n<type>file</type>\n<content>\n1: import sys\n2: from bisect import bisect_left\n3: \n4: \n5: def main():\n6:     data = list(map(int, sys.stdin.buffer.read().split()))\n7:     if not data:\n8:         return\n9:     n = data[0]\n10:     A = data[1:1 + n]\n11:     pos = 1 + n\n12:     q = data[pos]\n13:     pos += 1\n14: \n15:     # nxt[i] = first index j with A[j] >= 2*A[i]  (0-indexed, n if none)\n16:     nxt = [0] * n\n17:     for i in range(n):\n18:         nxt[i] = bisect_left(A, 2 * A[i])\n19: \n20:     # D[i] = nxt[i] - i.  For a query [L,R] and K pairs we need\n21:     # max_{i=L..L+K-1} D[i] <= (R-L+1) - K.\n22:     D = [nxt[i] - i for i in range(n)]\n23: \n24:     # Sparse table for range maximum of D.\n25:     st = [D]\n26:     length = 2\n27:     while length <= n:\n28:         half = length >> 1\n29:         prev = st[-1]\n30:         size = n - length + 1\n31:         cur = [0] * size\n32:         for i in range(size):\n33:             a = prev[i]\n34:             b = prev[i + half]\n35:             cur[i] = a if a >= b else b\n36:         st.append(cur)\n37:         length <<= 1\n38: \n39:     logs = [0] * (n + 1)\n40:     for i in range(2, n + 1):\n41:         logs[i] = logs[i >> 1] + 1\n42: \n43:     out = []\n44:     for _ in range(q):\n45:         L = data[pos] - 1\n46:         R = data[pos + 1] - 1\n47:         pos += 2\n48:         total = R - L + 1\n49:         lo, hi = 0, total // 2\n50:         # binary search for the largest feasible K\n51:         while lo < hi:\n52:             mid = (lo + hi + 1) >> 1\n53:             k = logs[mid]\n54:             # max D over [L, L+mid-1]\n55:             a = st[k][L]\n56:             b = st[k][L + mid - (1 << k)]\n57:             mx = a if a >= b else b\n58:             if mx <= total - mid:\n59:                 lo = mid\n60:             else:\n61:                 hi = mid - 1\n62:         out.append(str(lo))\n63: \n64:     sys.stdout.write(\"\\n\".join(out) + (\"\\n\" if out else \"\"))\n65: \n66: \n67: if __name__ == \"__main__\":\n68:     main()\n\n(End of file - total 68 lines)\n</content>"}
{"type": "tool_result", "callId": "call_03_rsF72r0F8p1JbFcEDJ3K0709", "status": "completed", "result": "<path>/Users/b612-lp/bench-workspaces/r1030/dsh/lcb-recent-hard-4/solutions/abc389_g.py</path>\n<type>file</type>\n<content>\n1: import sys\n2: \n3: \n4: def main():\n5:     data = list(map(int, sys.stdin.buffer.read().split()))\n6:     if not data:\n7:         return\n8:     N, P = data[0], data[1]\n9:     n = N // 2\n10:     maxdeg = N * (N - 1) // 2\n11: \n12:     # Binomial coefficients modulo P (P is prime, but only additions are used).\n13:     C = [[0] * (maxdeg + 1) for _ in range(maxdeg + 1)]\n14:     for i in range(maxdeg + 1):\n15:         row = C[i]\n16:         row[0] = 1 % P\n17:         prev = C[i - 1] if i else None\n18:         for j in range(1, i + 1):\n19:             v = prev[j - 1] + prev[j]\n20:             if v >= P:\n21:                 v -= P\n22:             row[j] = v\n23: \n24:     # Transfer from a layer of size a to the next layer of size b.\n25:     # All edges are counted through y = 1 + x, where x marks an edge.\n26:     # T[a][b](y) = sum_j (-1)^j C(b,j) y^(a(b-j) + C(b,2)).\n27:     T = [[None] * (n + 1) for _ in range(n + 1)]\n28:     for a in range(1, n + 1):\n29:         for b in range(1, n + 1):\n30:             base = b * (b - 1) // 2\n31:             terms = []\n32:             for j in range(b + 1):\n33:                 coef = C[b][j]\n34:                 if j & 1 and coef:\n35:                     coef = P - coef\n36:                 if coef:\n37:                     terms.append((a * (b - j) + base, coef))\n38:             T[a][b] = terms\n39: \n40:     # dp[t][(e,a,p)] is a polynomial in y.\n41:     # t     : vertices used so far (root included)\n42:     # e     : vertices in even layers so far (root included)\n43:     # a     : size of the current (last) layer\n44:     # p     : parity of the current layer (0 = even, 1 = odd)\n45:     dp = [{} for _ in range(N + 1)]\n46:     dp[1][(1, 1, 0)] = [1]\n47: \n48:     for t in range(1, N):\n49:         states = dp[t]\n50:         if not states:\n51:             continue\n52:         rem = N - t\n53:         for (e, a, p), poly in states.items():\n54:             maxb = min(n, rem)\n55:             if p == 0:\n56:                 # The next layer is odd.\n57:                 cap = n - (t - e)\n58:             else:\n59:                 # The next layer is even.\n60:                 cap = n - e\n61:             if cap < maxb:\n62:                 maxb = cap\n63:             lp = len(poly)\n64:             for b in range(1, maxb + 1):\n65:                 terms = T[a][b]\n66:                 ne = e + b if p == 1 else e\n67:                 key = (ne, b, 1 - p)\n68:                 dest = dp[t + b].get(key)\n69:                 newlen = lp + terms[0][0]\n70:                 if dest is None:\n71:                     dest = [0] * newlen\n72:                     dp[t + b][key] = dest\n73:                 elif len(dest) < newlen:\n74:                     dest.extend([0] * (newlen - len(dest)))\n75:                 mul = C[rem][b]\n76:                 for sh, coef in terms:\n77:                     cc = coef * mul % P\n78:                     for i in range(lp):\n79:                         dest[i + sh] = (dest[i + sh] + poly[i] * cc) % P\n80: \n81:     R = None\n82:     for (e, a, p), poly in dp[N].items():\n83:         if e != n:\n84:             continue\n85:         if R is None:\n86:             R = poly[:]\n87:         else:\n88:             if len(R) < len(poly):\n89:                 R.extend([0] * (len(poly) - len(R)))\n90:             for i, v in enumerate(poly):\n91:                 R[i] = (R[i] + v) % P\n92: \n93:     if R is None:\n94:         R = []\n95: \n96:     # R(y) = sum_d r[d] y^d with y = 1+x, so convert back to powers of x.\n97:     ans = []\n98:     for M in range(N - 1, maxdeg + 1):\n99:         s = 0\n100:         for d in range(M, len(R)):\n101:             s = (s + R[d] * C[d][M]) % P\n102:         ans.append(str(s))\n103: \n104:     sys.stdout.write(\" \".join(ans) + \"\\n\")\n105: \n106: \n107: if __name__ == \"__main__\":\n108:     main()\n\n(End of file - total 108 lines)\n</content>"}
