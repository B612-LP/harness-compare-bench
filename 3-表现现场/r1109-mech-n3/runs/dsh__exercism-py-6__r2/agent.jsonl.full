{"type": "tool_result", "callId": "call_00_HIAaGtHslVOpJ8rMe43z1662", "status": "completed", "result": "<path>/Users/b612-lp/bench-workspaces/r1030/dsh/exercism-py-6/inputs/exercises/dominoes/dominoes.py</path>\n<type>file</type>\n<content>\n1: def can_chain(dominoes):\n2:     if not dominoes:\n3:         return []\n4: \n5:     dominoes = [tuple(domino) for domino in dominoes]\n6:     adjacency = {}\n7:     for index, (a, b) in enumerate(dominoes):\n8:         adjacency.setdefault(a, []).append((b, index))\n9:         adjacency.setdefault(b, []).append((a, index))\n10: \n11:     # Every vertex in the non-empty graph must have even degree.\n12:     if any(len(edges) % 2 for edges in adjacency.values()):\n13:         return None\n14: \n15:     # All edges must belong to one connected component.\n16:     start = dominoes[0][0]\n17:     visited_vertices = {start}\n18:     pending = [start]\n19:     while pending:\n20:         vertex = pending.pop()\n21:         for neighbour, _ in adjacency[vertex]:\n22:             if neighbour not in visited_vertices:\n23:                 visited_vertices.add(neighbour)\n24:                 pending.append(neighbour)\n25:     if any(vertex for vertex in adjacency if vertex not in visited_vertices):\n26:         return None\n27: \n28:     # Hierholzer's algorithm for an Eulerian circuit.\n29:     used = [False] * len(dominoes)\n30:     next_edge = {vertex: 0 for vertex in adjacency}\n31:     vertex_stack = [start]\n32:     edge_stack = []\n33:     circuit = []\n34: \n35:     while vertex_stack:\n36:         vertex = vertex_stack[-1]\n37:         edges = adjacency[vertex]\n38:         while (\n39:             next_edge[vertex] < len(edges)\n40:             and used[edges[next_edge[vertex]][1]]\n41:         ):\n42:             next_edge[vertex] += 1\n43: \n44:         if next_edge[vertex] < len(edges):\n45:             neighbour, edge_index = edges[next_edge[vertex]]\n46:             used[edge_index] = True\n47:             edge_stack.append(edge_index)\n48:             vertex_stack.append(neighbour)\n49:         else:\n50:             vertex_stack.pop()\n51:             if edge_stack:\n52:                 circuit.append(edge_stack.pop())\n53: \n54:     circuit.reverse()\n55: \n56:     chain = []\n57:     current = start\n58:     for edge_index in circuit:\n59:         a, b = dominoes[edge_index]\n60:         if a == current:\n61:             chain.append((a, b))\n62:             current = b\n63:         else:\n64:             chain.append((b, a))\n65:             current = a\n66: \n67:     return chain\n\n(End of file - total 67 lines)\n</content>"}
