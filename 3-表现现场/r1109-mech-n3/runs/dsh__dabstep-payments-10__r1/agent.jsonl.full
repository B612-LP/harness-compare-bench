{"type": "tool_call", "callId": "call_00_umB5s7QBz63OwTf74o7c6975", "tool": "bash", "input": {"command": "cd /Users/b612-lp/bench-workspaces/r1030/dsh/dabstep-payments-10 && python3 - <<'PY'\nimport json\nfees=json.load(open('inputs/fees.json'))\ndef calc(cond):\n vals=[]\n for f in fees:\n  if not cond(f): continue\n  vals.append(f['fixed_amount']+f['rate']*10/10000)\n return len(vals),sum(vals)/len(vals) if vals else None\nprint('1273 strict credit true GlobalCard',calc(lambda f:f['card_scheme']=='GlobalCard' and f['is_credit'] is True))\nprint('1273 credit true or null',calc(lambda f:f['card_scheme']=='GlobalCard' and f['is_credit'] in (True,None)))\nprint('1273 credit true only non-null',calc(lambda f:f['card_scheme']=='GlobalCard' and f['is_credit'] is not False))\nprint('1305 H+5812 GlobalCard strict',calc(lambda f:f['card_scheme']=='GlobalCard' and f['is_credit'] in (True,None) and (not f['account_type'] or 'H' in f['account_type']) and (not f['merchant_category_code'] or 5812 in f['merchant_category_code'])))\nprint('1305 variants')\nfor ic in [True,None,'notfalse']:\n for at in ['empty_or_contains','contains_only','empty_only']:\n  for mcc in ['empty_or_contains','contains_only','empty_only']:\n   def ok(f,ic=ic,at=at,mcc=mcc):\n    if f['card_scheme']!='GlobalCard': return False\n    if ic is True and f['is_credit'] is not True: return False\n    if ic is None and f['is_credit'] is not None: return False\n    if ic=='notfalse' and f['is_credit'] is False: return False\n    if at=='empty_or_contains' and f['account_type'] and 'H' not in f['account_type']: return False\n    if at=='contains_only' and 'H' not in f['account_type']: return False\n    if at=='empty_only' and f['account_type']: return False\n    if mcc=='empty_or_contains' and f['merchant_category_code'] and 5812 not in f['merchant_category_code']: return False\n    if mcc=='contains_only' and 5812 not in f['merchant_category_code']: return False\n    if mcc=='empty_only' and f['merchant_category_code']: return False\n    return True\n   n,a=calc(ok)\n   if n and abs(a-0.123217)<1e-6: print('MATCH',ic,at,mcc,n,a)\nPY", "description": "Verify average-fee questions semantics"}}
