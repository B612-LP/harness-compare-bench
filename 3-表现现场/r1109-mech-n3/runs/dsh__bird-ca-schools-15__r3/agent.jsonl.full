{"type": "tool_result", "callId": "call_00_rba49lhocnLKkVLmVkTV2909", "status": "completed", "result": "{\"question_id\": 28, \"sql\": \"SELECT s.School, s.DOC FROM schools s JOIN frpm f ON s.CDSCode = f.CDSCode WHERE s.FundingType = 'Locally funded' AND f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)` > (SELECT AVG(f2.`Enrollment (K-12)` - f2.`Enrollment (Ages 5-17)`) FROM schools s2 JOIN frpm f2 ON s2.CDSCode = f2.CDSCode WHERE s2.FundingType = 'Locally funded')\"}\n{\"question_id\": 36, \"sql\": \"SELECT s.AdmFName1, s.AdmLName1, s.AdmFName2, s.AdmLName2, s.AdmFName3, s.AdmLName3 FROM satscores sa JOIN schools s ON sa.cds = s.CDSCode ORDER BY sa.NumGE1500 DESC LIMIT 1\"}\n{\"question_id\": 62, \"sql\": \"SELECT COUNT(*) FROM schools s JOIN frpm f ON s.CDSCode = f.CDSCode WHERE s.County = 'Los Angeles' AND s.Charter = 0 AND f.`Free Meal Count (K-12)` * 100.0 / f.`Enrollment (K-12)` < 0.18\"}\n{\"question_id\": 83, \"sql\": \"SELECT s.City, COUNT(*) FROM schools s JOIN frpm f ON s.CDSCode = f.CDSCode WHERE s.Magnet = 1 AND s.GSserved = 'K-8' AND f.`NSLP Provision Status` = 'Multiple Provision Types' GROUP BY s.City\"}\n{\"question_id\": 87, \"sql\": \"SELECT s.AdmEmail1, s.AdmEmail2 FROM schools s WHERE s.County = 'San Bernardino' AND s.City = 'San Bernardino' AND s.DOC = '54' AND s.OpenDate BETWEEN '2009-01-01' AND '2010-12-31' AND s.SOC = '62'\"}\n{\"question_id\": 12, \"sql\": \"SELECT MAX(f.`Free Meal Count (Ages 5-17)` * 1.0 / f.`Enrollment (Ages 5-17)`) FROM satscores sa JOIN frpm f ON sa.cds = f.CDSCode WHERE sa.NumGE1500 * 1.0 / sa.NumTstTakr > 0.3\"}\n{\"question_id\": 23, \"sql\": \"SELECT s.School, s.Street FROM schools s JOIN frpm f ON s.CDSCode = f.CDSCode WHERE f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)` > 30\"}\n{\"question_id\": 24, \"sql\": \"SELECT f.`School Name` FROM frpm f JOIN satscores sa ON f.CDSCode = sa.cds WHERE f.`Free Meal Count (K-12)` / f.`Enrollment (K-12)` > 0.1 AND sa.NumGE1500 > 0\"}\n{\"question_id\": 25, \"sql\": \"SELECT sa.sname, f.`Charter Funding Type` FROM satscores sa JOIN frpm f ON sa.cds = f.CDSCode WHERE f.`District Name` LIKE 'Riverside%' AND sa.AvgScrMath > 400\"}\n{\"question_id\": 26, \"sql\": \"SELECT f.`School Name`, s.Street, s.City, s.State, s.Zip FROM frpm f JOIN schools s ON f.CDSCode = s.CDSCode WHERE s.County = 'Monterey' AND f.`School Type` = 'High Schools (Public)' AND f.`FRPM Count (Ages 5-17)` > 800\"}\n{\"question_id\": 27, \"sql\": \"SELECT s.School, sa.AvgScrWrite, s.Phone FROM schools s LEFT JOIN satscores sa ON s.CDSCode = sa.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\"}\n{\"question_id\": 31, \"sql\": \"SELECT `Free Meal Count (K-12)` * 1.0 / `Enrollment (K-12)` AS ratio FROM frpm ORDER BY `Enrollment (K-12)` DESC LIMIT 2 OFFSET 9\"}\n{\"question_id\": 5, \"sql\": \"SELECT COUNT(*) FROM satscores sa JOIN schools s ON sa.cds = s.CDSCode WHERE sa.AvgScrMath > 400 AND s.Virtual = 'F'\"}\n{\"question_id\": 11, \"sql\": \"SELECT CDSCode FROM frpm WHERE `Enrollment (K-12)` + `Enrollment (Ages 5-17)` > 500\"}\n{\"question_id\": 17, \"sql\": \"SELECT s.CharterNum, sa.AvgScrWrite, RANK() OVER (ORDER BY sa.AvgScrWrite DESC) AS WritingScoreRank FROM schools s JOIN satscores sa ON s.CDSCode = sa.cds WHERE sa.AvgScrWrite > 499 AND s.CharterNum IS NOT NULL\"}\n---META---\n{\n  \"batch\": \"r1109-mech-n3\",\n  \"rule_version\": \"freeze-20261029-v2\",\n  \"product\": \"dsh\",\n  \"case\": \"bird-ca-schools-15\",\n  \"rep\": \"1\",\n  \"event_id\": \"mech-n3-dsh-bird-ca-schools-15-r1\",\n  \"form\": \"cli\",\n  \"preregistration_commit\": \"704d2bb\",\n  \"workspace\": \"/Users/b612-lp/bench-workspaces/r1030/dsh/bird-ca-schools-15\",\n  \"created_at\": \"2026-11-09T11:54:35+08:00\",\n  \"model\": \"deepseek-flash\",\n  \"reasoning_effort\": \"low\",\n  \"product_version\": \"0.2.0-rc.2\",\n  \"route\": {\n    \"host\": \"api.deepseek.com\",\n    \"provider_id\": \"deepseek-official\",\n    \"wire_protocol\": \"anthropic-messages\",\n    \"end