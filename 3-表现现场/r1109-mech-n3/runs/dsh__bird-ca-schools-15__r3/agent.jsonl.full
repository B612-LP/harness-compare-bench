{"type": "tool_call", "callId": "call_00_HRnPmQTr9b6mhPmQDbO06935", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport sqlite3\ncon=sqlite3.connect('inputs/db/california_schools.sqlite'); c=con.cursor()\ndef q(label,sql):\n print('\\n'+label)\n for r in c.execute(sql).fetchall(): print(tuple(r))\nq('riverside districts counts','''SELECT f.`District Name`,COUNT(*) FROM frpm f WHERE f.`District Name` LIKE 'Riverside%' GROUP BY f.`District Name`''')\nq('riverside joined sats','''SELECT sa.cds,sa.sname,sa.AvgScrMath,f.`District Name`,f.`Charter Funding Type` FROM satscores sa JOIN frpm f ON sa.cds=f.CDSCode WHERE f.`District Name` LIKE 'Riverside%' ORDER BY sa.AvgScrMath DESC''')\nq('overall avg math','''SELECT SUM(AvgScrMath),COUNT(*),AVG(AvgScrMath) FROM satscores WHERE AvgScrMath IS NOT NULL''')\nq('riverside avg math','''SELECT SUM(sa.AvgScrMath),COUNT(*) FROM satscores sa JOIN frpm f ON sa.cds=f.CDSCode WHERE f.`District Name` LIKE 'Riverside%' ''')\nPY", "description": "Inspect q25 Riverside SAT data"}}
