{"type": "tool_call", "callId": "call_00_WQQlRvnrhhq24dvVsFP69254", "tool": "bash", "input": {"command": "time python3 - << 'PY'\nfrom itertools import combinations\nfrom collections import deque\nN=8\nedges=[(i,j) for i in range(N) for j in range(i+1,N)]\nE=len(edges)\nfor M in [8]:\n    cnt=0\n    for combo in combinations(range(E),M):\n        adj=[0]*N\n        for k in combo:\n            u,v=edges[k]; adj[u]|=1<<v; adj[v]|=1<<u\n        seen=1; frontier=1; dist=[-1]*N; dist[0]=0\n        d=0\n        while frontier:\n            d+=1; nxt=0\n            f=frontier\n            while f:\n                b=f&-f; u=b.bit_length()-1; f-=b\n                nb=adj[u] & ~seen\n                nxt|=nb; seen|=nb\n                # assign dist\n                x=nb\n                while x:\n                    bb=x&-x; vv=bb.bit_length()-1; x-=bb; dist[vv]=d\n            frontier=nxt\n            if seen==(1<<N)-1: break\n        if seen!=(1<<N)-1: continue\n        e=sum(1 for x in dist if x%2==0)\n        if e==N//2: cnt+=1\n    print('N=8 M=8',cnt)\nPY", "description": "Brute count N=8 M=8 balanced connected graphs", "timeoutMs": 300000}}
