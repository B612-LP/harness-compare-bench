{"type": "tool_call", "callId": "call_00_v4x6kYlXJ3mRDvLpeMiD4652", "tool": "bash", "input": {"command": "python3 - << 'PY'\nimport random, subprocess, bisect\nfrom functools import lru_cache\n\ndef exact(arr):\n    arr=tuple(arr)\n    @lru_cache(None)\n    def f(mask):\n        # choose smallest set bit as lower or skip? Need choose pairing; max matching\n        if not mask: return 0\n        # lowest index can be upper or lower or unused. Actually any pair; pick lowest index because if unused skip or pair as lower (as lower since smallest) \n        i=(mask & -mask).bit_length()-1\n        best=f(mask & ~(1<<i)) # unused\n        # as lower paired with j\n        for j in range(i+1,len(arr)):\n            if mask>>j & 1 and 2*arr[i] <= arr[j]:\n                best=max(best,1+f(mask & ~(1<<i) & ~(1<<j)))\n        return best\n    return f((1<<len(arr))-1)\n\ndef formula(arr):\n    n=len(arr)\n    A=arr\n    nxt=[bisect.bisect_left(A,2*A[i]) for i in range(n)]\n    D=[nxt[i]-i for i in range(n)]\n    T=n\n    lo,hi=0,T//2\n    while lo<hi:\n        mid=(lo+hi+1)//2\n        if max(D[i] for i in range(mid)) <= T-mid: lo=mid\n        else: hi=mid-1\n    return lo\n\nfor n in range(2,13):\n  for _ in range(500):\n    arr=sorted(random.randint(1,30) for _ in range(n))\n    e=exact(arr); f=formula(arr)\n    if e!=f:\n      print('FAIL',arr,e,f); raise SystemExit\nprint('formula ok')\n\n# test solution random against exact\nfor _ in range(100):\n    n=random.randint(2,12)\n    arr=sorted(random.randint(1,50) for _ in range(n))\n    q=random.randint(1,10)\n    qs=[]\n    for _ in range(q):\n        l=random.randint(1,n-1); r=random.randint(l+1,n)\n        qs.append((l,r))\n    inp=f'{n}\\n'+ ' '.join(map(str,arr))+f'\\n{q}\\n'+''.join(f'{l} {r}\\n' for l,r in qs)\n    exp=[exact(arr[l-1:r]) for l,r in qs]\n    got=list(map(int,subprocess.run(['python3','solutions/abc388_g.py'],input=inp,text=True,capture_output=True).stdout.split()))\n    if got!=exp:\n        print('SOL FAIL',arr,qs,exp,got); break\nelse: print('solution ok')\nPY", "description": "Validate abc388_g formula and solution", "timeoutMs": 300000}}
