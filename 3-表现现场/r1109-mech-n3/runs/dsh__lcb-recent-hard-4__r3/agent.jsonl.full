{"type": "tool_result", "callId": "call_00_u19cVbrxzblxgM9yJxVe3992", "status": "completed", "result": "==== solutions/abc387_f.py\nimport sys\nfrom collections import deque\n\nMOD = 998244353\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    n, m = data[0], data[1]\n    a = [x - 1 for x in data[2:2 + n]]\n\n    # f[v][k] = number of ways in the subtree rooted at v (tree edges only)\n    # when x_v = k.  Index k runs from 0..m (0 is unused).\n    f = [[1] * (m + 1) for _ in range(n)]\n    indeg = [0] * n\n    for v in a:\n        indeg[v] += 1\n\n    q = deque(i for i in range(n) if indeg[i] == 0)\n    while q:\n        v = q.popleft()\n        fv = f[v]\n        pref = [0] * (m + 1)\n        s = 0\n        for k in range(1, m + 1):\n            s += fv[k]\n            if s >= MOD:\n                s -= MOD\n            pref[k] = s\n        p = a[v]\n        fp = f[p]\n        for k in range(1, m + 1):\n            fp[k] = fp[k] * pref[k] % MOD\n        indeg[p] -= 1\n        if indeg[p] == 0:\n            q.append(p)\n\n    # Remaining vertices form directed cycles.\n    visited = [False] * n\n    ans = 1\n    for start in range(n):\n        if indeg[start] == 0 or visited[start]:\n            continue\n        cyc = []\n        v = start\n        while not visited[v]:\n            visited[v] = True\n            cyc.append(v)\n            v = a[v]\n        total = [0] * (m + 1)\n        for k in range(1, m + 1):\n            prod = 1\n            for u in cyc:\n                prod = prod * f[u][k] % MOD\n            total[k] = prod\n        s = 0\n        for k in range(1, m + 1):\n            s += total[k]\n            if s >= MOD:\n                s -= MOD\n        ans = ans * (s % MOD) % MOD\n\n    print(ans % MOD)\n\n\nif __name__ == \"__main__\":\n    main()\n==== solutions/abc388_f.py\nimport sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    n, m, A, B = data[0:4]\n    intervals = []\n    idx = 4\n    for _ in range(m):\n        L, R = data[idx], data[idx + 1]\n        idx += 2\n        intervals.append((L, R))\n\n    if A == B:\n        # The only possible move is +A.\n        if (n - 1) % A != 0:\n            print(\"No\")\n            return\n        # Every cell of the progression 1, 1+A, ... must be good.\n        for L, R in intervals:\n            # First number >= L congruent to 1 modulo A.\n            first = L + ((1 - L) % A)\n            if first <= R and first < n:\n                print(\"No\")\n                return\n        print(\"Yes\")\n        return\n\n    full = (1 << B) - 1\n    # Bits d-1 for A <= d <= B.\n    allowed = ((1 << (B - A + 1)) - 1) << (A - 1)\n\n    # mask bit j means: position (cur - j) is reachable.\n    # Initially cur = 1 and position 1 is reachable.\n    mask = 1\n    cur = 1\n    LIMIT = 2 * B * B + 10\n\n    def advance_good(length):\n        nonlocal mask\n        if length <= 0:\n            return\n        if mask == full:\n            return\n        if mask == 0:\n            return\n        steps = length if length < LIMIT else LIMIT\n        for _ in range(steps):\n            if mask == full:\n                return\n            nb = 1 if (mask & allowed) else 0\n            mask = ((mask << 1) | nb) & full\n        # For A < B a non-empty mask becomes full within O(B^2) steps.\n        # The loop above therefore normally exits through the 'full' check;\n        # leaving it untouched here is still correct for any remaining steps\n        # because a full mask stays full.\n\n    def advance_bad(length):\n        nonlocal mask\n        if length <= 0 or mask == 0:\n            return\n        steps = length if length < B else B\n        for _ in range(steps):\n            mask = (mask << 1) & full\n        # After B shifts the mask is zero; any remaining bad cells keep it zero.\n\n    for L, R in intervals:\n        advance_good(L - cur - 1)\n        advance_bad(R - L + 1)\n        cur = R\n\n    advance_good(n - cur)\n    print(\"Yes\" if (mask & 1) else \"No\")\n\n\nif __name__ == \"__main__\":\n    main()\n==== solutions/abc388_g.py\nimport sys\nfrom bisect import bisect_left\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    n = data[0]\n    A = data[1:1 + n]\n    pos = 1 + n\n    q = data[pos]\n    pos += 1\n\n    # nxt[i] = first index j with A[j] >= 2*A[i]  (0-indexed, n if none)\n    nxt = [0] * n\n    for i in range(n):\n        nxt[i] = bisect_left(A, 2 * A[i])\n\n    # D[i] = nxt[i] - i.  For a query [L,R] and K pairs we need\n    # max_{i=L..L+K-1} D[i] <= (R-L+1) - K.\n    D = [nxt[i] - i for i in range(n)]\n\n    # Sparse table for range maximum of D.\n    st = [D]\n    length = 2\n    while length <= n:\n        half = length >> 1\n        prev = st[-1]\n        size = n - length + 1\n        cur = [0] * size\n        for i in range(size):\n            a = prev[i]\n            b = prev[i + half]\n            cur[i] = a if a >= b else b\n        st.append(cur)\n        length <<= 1\n\n    logs = [0] * (n + 1)\n    for i in range(2, n + 1):\n        logs[i] = logs[i >> 1] + 1\n\n    out = []\n    for _ in range(q):\n        L = data[pos] - 1\n        R = data[pos + 1] - 1\n        pos += 2\n        total = R - L + 1\n        lo, hi = 0, total // 2\n        # binary search for the largest feasible K\n        while lo < hi:\n            mid = (lo + hi + 1) >> 1\n            k = logs[mid]\n            # max D over [L, L+mid-1]\n            a = st[k][L]\n            b = st[k][L + mid - (1 << k)]\n            mx = a if a >= b else b\n            if mx <= total - mid:\n                lo = mid\n            else:\n                hi = mid - 1\n        out.append(str(lo))\n\n    sys.stdout.write(\"\\n\".join(out) + (\"\\n\" if out else \"\"))\n\n\nif __name__ == \"__main__\":\n    main()\n==== solutions/abc389_g.py\nimport sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    N, P = data[0], data[1]\n    n = N // 2\n    maxdeg = N * (N - 1) // 2\n\n    # Binomial coefficients modulo P (P is prime, but only additions are used).\n    C = [[0] * (maxdeg + 1) for _ in range(maxdeg + 1)]\n    for i in range(maxdeg + 1):\n        row = C[i]\n        row[0] = 1 % P\n        prev = C[i - 1] if i else None\n        for j in range(1, i + 1):\n            v = prev[j - 1] + prev[j]\n            if v >= P:\n                v -= P\n            row[j] = v\n\n    # Transfer from a layer of size a to the next layer of size b.\n    # All edges are counted through y = 1 + x, where x marks an edge.\n    # T[a][b](y) = sum_j (-1)^j C(b,j) y^(a(b-j) + C(b,2)).\n    T = [[None] * (n + 1) for _ in range(n + 1)]\n    for a in range(1, n + 1):\n        for b in range(1, n + 1):\n            base = b * (b - 1) // 2\n            terms = []\n            for j in range(b + 1):\n                coef = C[b][j]\n                if j & 1 and coef:\n                    coef = P - coef\n                if coef:\n                    terms.append((a * (b - j) + base, coef))\n            T[a][b] = terms\n\n    # dp[t][(e,a,p)] is a polynomial in y.\n    # t     : vertices used so far (root included)\n    # e     : vertices in even layers so far (root included)\n    # a     : size of the current (last) layer\n    # p     : parity of the current layer (0 = even, 1 = odd)\n    dp = [{} for _ in range(N + 1)]\n    dp[1][(1, 1, 0)] = [1]\n\n    for t in range(1, N):\n        states = dp[t]\n        if not states:\n            continue\n        rem = N - t\n        for (e, a, p), poly in states.items():\n            maxb = min(n, rem)\n            if p == 0:\n                # The next layer is odd.\n                cap = n - (t - e)\n            else:\n                # The next layer is even.\n                cap = n - e\n            if cap < maxb:\n                maxb = cap\n            lp = len(poly)\n            for b in range(1, maxb + 1):\n                terms = T[a][b]\n                ne = e + b if p == 1 else e\n                key = (ne, b, 1 - p)\n                dest = dp[t + b].get(key)\n                newlen = lp + terms[0][0]\n                if dest is None:\n                    dest = [0] * newlen\n                    dp[t + b][key] = dest\n                elif len(dest) < newlen:\n                    dest.extend([0] * (newlen - len(dest)))\n                mul = C[rem][b]\n                for sh, coef in terms:\n                    cc = coef * mul % P\n                    for i in range(lp):\n                        dest[i + sh] = (dest[i + sh] + poly[i] * cc) % P\n\n    R = None\n    for (e, a, p), poly in dp[N].items():\n        if e != n:\n            continue\n        if R is None:\n            R = poly[:]\n        else:\n            if len(R) < len(poly):\n                R.extend([0] * (len(poly) - len(R)))\n            for i, v in enumerate(poly):\n                R[i] = (R[i] + v) % P\n\n    if R is None:\n        R = []\n\n    # R(y) = sum_d r[d] y^d with y = 1+x, so convert back to powers of x.\n    ans = []\n    for M in range(N - 1, maxdeg + 1):\n        s = 0\n        for d in range(M, len(R)):\n            s = (s + R[d] * C[d][M]) % P\n        ans.append(str(s))\n\n    sys.stdout.write(\" \".join(ans) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}
