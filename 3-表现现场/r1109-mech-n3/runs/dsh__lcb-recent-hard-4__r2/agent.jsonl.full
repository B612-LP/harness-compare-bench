{"type": "tool_call", "callId": "call_00_JrmmLT7xTvIUa1SHH3qN7195", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport random\nrandom.seed(0)\nworst=(0,None)\nfor B in range(2,21):\n  for A in range(1,B):\n    full=(1<<B)-1; allowed=((1<<(B-A+1))-1)<<(A-1)\n    for _ in range(20000):\n      m0=random.randrange(1,1<<B)\n      # bias toward sparse masks sometimes\n      if random.random()<0.5: m0=1<<random.randrange(B)\n      mask=m0\n      for step in range(1,2*B*B+11):\n        nb=1 if mask&allowed else 0\n        mask=((mask<<1)|nb)&full\n        if mask==full: break\n      if mask!=full:\n        print('COUNTER',A,B,m0,step); raise SystemExit\n      if step>worst[0]: worst=(step,(A,B,m0))\nprint('worst random',worst)\nPY", "description": "Random stress mask saturation bound up to B=20", "timeoutMs": 120000}}
