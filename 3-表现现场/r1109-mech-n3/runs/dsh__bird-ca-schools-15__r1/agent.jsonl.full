 JOIN schools s ON f.CDSCode = s.CDSCode WHERE s.County = 'Monterey' AND f.`School Type` = 'High Schools (Public)' AND f.`FRPM Count (Ages 5-17)` > 800\",\n27: \"SELECT s.School, sa.AvgScrWrite, s.Phone FROM schools s LEFT JOIN satscores sa ON s.CDSCode = sa.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\",\n31: \"SELECT `Free Meal Count (K-12)` * 1.0 / `Enrollment (K-12)` AS ratio FROM frpm ORDER BY `Enrollment (K-12)` DESC LIMIT 2 OFFSET 9\",\n5: \"SELECT COUNT(*) FROM satscores sa JOIN schools s ON sa.cds = s.CDSCode WHERE sa.AvgScrMath > 400 AND s.Virtual = 'F'\",\n11: \"SELECT CDSCode FROM frpm WHERE `Enrollment (K-12)` + `Enrollment (Ages 5-17)` > 500\",\n17: \"SELECT s.CharterNum, sa.AvgScrWrite, RANK() OVER (ORDER BY sa.AvgScrWrite DESC) AS WritingScoreRank FROM schools s JOIN satscores sa ON s.CDSCode = sa.cds WHERE sa.AvgScrWrite > 499 AND s.CharterNum IS NOT NULL\",\n}\n# order as in questions.json\nimport json as J\nqs=J.load(open('inputs/questions.json'))\nassert set(answers)=={q['question_id'] for q in qs}\nwith open('answers.jsonl','w') as out:\n    for q in qs:\n        out.write(J.dumps({'question_id':q['question_id'],'sql':answers[q['question_id']]}, ensure_ascii=False)+'\\n')\nprint('wrote',len(qs))\nPY\npython3 - <<'PY'\nimport json,sqlite3\nc=sqlite3.connect('inputs/db/california_schools.sqlite')\nlines=open('answers.jsonl').read().splitlines()\nprint('lines',len(lines))\nfor line in lines:\n o=json.loads(line)\n rows=c.execute(o['sql']).fetchall()\n print(o['question_id'],'rows',len(rows),'sample',rows[:2])\nPY", "description": "Write answers and validate all queries"}}
