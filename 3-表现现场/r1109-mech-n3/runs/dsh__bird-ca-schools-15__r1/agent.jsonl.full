{"type": "tool_call", "callId": "call_00_vJrt3iUWPy17HBtwzygv8206", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport sqlite3\nc=sqlite3.connect('inputs/db/california_schools.sqlite')\nc.row_factory=sqlite3.Row\ndef show(name,q,limit=200):\n print('\\n===',name)\n try:\n  rows=c.execute(q).fetchall()\n  print('n=',len(rows))\n  for r in rows[:limit]: print(tuple(r))\n except Exception as e: print('ERR',e)\n\nshow('28',\"\"\"\nSELECT s.School, s.DOC, f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)` d\nFROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode\nWHERE s.FundingType='Locally funded'\nAND f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)` > (\n SELECT AVG(f2.`Enrollment (K-12)` - f2.`Enrollment (Ages 5-17)`)\n FROM schools s2 JOIN frpm f2 ON s2.CDSCode=f2.CDSCode WHERE s2.FundingType='Locally funded')\n\"\"\")\nshow('28 avg',\"\"\"SELECT AVG(f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)`), count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.FundingType='Locally funded'\"\"\")\n\nshow('36',\"\"\"\nSELECT s.AdmFName1,s.AdmLName1,s.AdmFName2,s.AdmLName2,s.AdmFName3,s.AdmLName3,sa.NumGE1500,s.School\nFROM satscores sa JOIN schools s ON sa.cds=s.CDSCode\nORDER BY sa.NumGE1500 DESC LIMIT 10\"\"\")\n\nshow('62 var1',\"\"\"SELECT count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.County='Los Angeles' AND s.Charter=0 AND f.`Free Meal Count (K-12)`*100/f.`Enrollment (K-12)` < 0.18\"\"\")\nshow('62 var2',\"\"\"SELECT count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.County='Los Angeles' AND s.Charter=0 AND f.`Free Meal Count (K-12)`/f.`Enrollment (K-12)` < 0.0018\"\"\")\nshow('62 var3',\"\"\"SELECT count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.County='Los Angeles' AND s.Charter=0 AND f.`Percent (%) Eligible Free (K-12)` < 0.18\"\"\")\nshow('62 var4',\"\"\"SELECT count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.County='Los Angeles' AND s.Charter=0 AND f.`Percent (%) Eligible Free (K-12)` < 0.0018\"\"\")\n\nshow('83 GSserved',\"\"\"SELECT s.City,count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.Magnet=1 AND s.GSserved='K-8' AND f.`NSLP Provision Status`='Multiple Provision Types' GROUP BY s.City ORDER BY s.City\"\"\")\nshow('83 grades',\"\"\"SELECT s.City,count(*) FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.Magnet=1 AND f.`Low Grade`='K' AND f.`High Grade`='8' AND f.`NSLP Provision Status`='Multiple Provision Types' GROUP BY s.City ORDER BY s.City\"\"\")\nshow('83 detail',\"\"\"SELECT s.City,s.School,s.GSserved,f.`Low Grade`,f.`High Grade`,f.`NSLP Provision Status` FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.Magnet=1 AND f.`NSLP Provision Status`='Multiple Provision Types'\"\"\")\n\nshow('87',\"\"\"SELECT s.School,s.AdmEmail1,s.AdmEmail2,s.OpenDate,s.DOC,s.SOC,s.City,s.County FROM schools s WHERE s.County='San Bernardino' AND s.City='San Bernardino' AND s.DOC='54' AND s.OpenDate BETWEEN '2009-01-01' AND '2010-12-31' AND s.SOC='62'\"\"\")\nPY", "description": "Test candidate SQL for first questions"}}
