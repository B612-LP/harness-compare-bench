{"type": "tool_call", "callId": "call_00_YHXduhxIJEA5SZIdV9BP4251", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport sqlite3\nc=sqlite3.connect('inputs/db/california_schools.sqlite'); c.row_factory=sqlite3.Row\ndef show(name,q):\n print('\\n===',name)\n rows=c.execute(q).fetchall(); print('n',len(rows))\n for r in rows[:20]: print(tuple(r))\nbase=\"\"\"SELECT s.School,sa.AvgScrWrite,s.Phone,s.CDSCode,s.OpenDate,s.ClosedDate,sa.cds\nFROM schools s LEFT JOIN satscores sa ON s.CDSCode=sa.cds\nWHERE %s\"\"\"\nconds={\n 'open > 1991-12-31 or close <2000-01-01':\"s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\",\n 'open >= 1992 or close <=1999':\"s.OpenDate >= '1992-01-01' OR s.ClosedDate <= '1999-12-31'\",\n 'year(open)>1991 or year(close)<2000':\"CAST(strftime('%Y',s.OpenDate) AS INT)>1991 OR CAST(strftime('%Y',s.ClosedDate) AS INT)<2000\",\n 'open>1991 or close<2000':\"s.OpenDate > '1991' OR s.ClosedDate < '2000'\",\n}\nfor k,v in conds.items(): show(k,base%v)\nshow('matching sat among date',\"\"\"SELECT count(*) FROM schools s JOIN satscores sa ON s.CDSCode=sa.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\"\"\")\nshow('rtype among matched',\"\"\"SELECT sa.rtype,count(*) FROM schools s JOIN satscores sa ON s.CDSCode=sa.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01' GROUP BY 1\"\"\")\nPY", "description": "Check q27 date variants and counts"}}
