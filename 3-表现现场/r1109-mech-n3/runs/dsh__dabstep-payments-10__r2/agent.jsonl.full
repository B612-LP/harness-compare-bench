{"type": "tool_call", "callId": "call_00_2iaTNQPI2QObvi7x1weZ7611", "tool": "bash", "input": {"command": "python3 - <<'EOF'\nimport json,csv,datetime,collections\nfees=json.load(open('inputs/fees.json'))\nmd={m['merchant']:m for m in json.load(open('inputs/merchant_data.json'))}\ndef vmatch(v,val):\n    if v is None: return True\n    if isinstance(v,list): return len(v)==0 or val in v\n    return str(v)==str(val)\ndef applicable(r,mer,vol,fraud):\n    out=[]\n    intra=1.0 if r['issuing_country']==r['acquirer_country'] else 0.0\n    for f in fees:\n        if f['card_scheme'] is not None and f['card_scheme']!=r['card_scheme']: continue\n        if not vmatch(f['account_type'],mer['account_type']): continue\n        if f['capture_delay'] is not None and f['capture_delay']!='<3': continue\n        if f['monthly_volume'] is not None and f['monthly_volume']!='100k-1m': continue\n        if f['monthly_fraud_level'] is not None and f['monthly_fraud_level']!='>8.3%': continue\n        if not vmatch(f['merchant_category_code'],mer['merchant_category_code']): continue\n        if not vmatch(f['is_credit'],r['is_credit']=='True'): continue\n        if not vmatch(f['aci'],r['aci']): continue\n        if f['intracountry'] is not None and float(f['intracountry'])!=intra: continue\n        out.append(f['ID'])\n    return out\nrows=[]\nwith open('inputs/payments.csv') as f:\n    for r in csv.DictReader(f):\n        if r['merchant']=='Belles_cookbook_store' and ((int(r['day_of_year'])-1)//31==0): pass\n        if r['merchant']=='Belles_cookbook_store':\n            d=int(r['day_of_year']); m=(datetime.date(2023,1,1)+datetime.timedelta(d-1)).month\n            if m==1: rows.append(r)\nfor r in rows:\n    if r['card_scheme']=='NexPay' and r['is_credit']=='True' and r['aci'] in ('B','C'):\n        a=applicable(r,md['Belles_cookbook_store'],113260,10.313)\n        if 384 not in a:\n            print('384 not in',r)\n        # print first few\n# distribution overlap count for those with 384\ncnt=collections.Counter()\nex=[]\nfor r in rows:\n    a=applicable(r,md['Belles_cookbook_store'],113260,10.313)\n    if 384 in a:\n        cnt[len(a)]+=1\n        if len(ex)<10: ex.append((r['card_scheme'],r['is_credit'],r['aci'],r['issuing_country'],a))\nprint('overlap for 384 tx',cnt)\nprint(ex)\nEOF", "description": "Analyze overlaps for fee 384 transactions"}}
