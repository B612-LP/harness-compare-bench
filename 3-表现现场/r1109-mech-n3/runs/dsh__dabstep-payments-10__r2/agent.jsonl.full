{"type": "tool_call", "callId": "call_00_kWrU6xE2az0qRGV5khLm6025", "tool": "bash", "input": {"command": "python3 - <<'EOF'\nimport json,csv,datetime,collections\nfees=json.load(open('inputs/fees.json'))\ndef L(v,val):\n    if v is None: return True\n    if isinstance(v,list): return len(v)==0 or val in v\n    return str(v)==str(val)\nrows=[]\nfor r in csv.DictReader(open('inputs/payments.csv')):\n    if r['merchant']=='Belles_cookbook_store':\n        d=int(r['day_of_year']); m=(datetime.date(2023,1,1)+datetime.timedelta(d-1)).month\n        if m==1 and r['has_fraudulent_dispute']=='True': rows.append(r)\ndef matches(r,aci):\n    out=[]\n    intra=1.0 if r['issuing_country']==r['acquirer_country'] else 0.0\n    for f in fees:\n        if f['card_scheme'] is not None and f['card_scheme']!=r['card_scheme']: continue\n        if not L(f['account_type'],'R'): continue\n        if f['capture_delay'] is not None and f['capture_delay']!='<3': continue\n        if f['monthly_volume'] is not None and f['monthly_volume']!='100k-1m': continue\n        if f['monthly_fraud_level'] is not None and f['monthly_fraud_level']!='>8.3%': continue\n        if not L(f['merchant_category_code'],5942): continue\n        if not L(f['is_credit'],True): continue\n        if not L(f['aci'],aci): continue\n        if f['intracountry'] is not None and float(f['intracountry'])!=intra: continue\n        out.append(f)\n    return out\ndef feval(f,a): return f['fixed_amount']+f['rate']*a/10000\nfor mode in ['sum','avg','min']:\n    print('MODE',mode)\n    for aci in 'ABCDEFG':\n        tot=0\n        for r in rows:\n            ms=matches(r,aci); a=float(r['eur_amount'])\n            vals=[feval(f,a) for f in ms]\n            if not vals: continue\n            if mode=='sum': tot+=sum(vals)\n            elif mode=='avg': tot+=sum(vals)/len(vals)\n            else: tot+=min(vals)\n        print(aci,round(tot,6))\n    # per scheme\n    for sch in sorted(set(r['card_scheme'] for r in rows)):\n        rr=[r for r in rows if r['card_scheme']==sch]\n        line=[]\n        for aci in 'ABCDEFG':\n            tot=0\n            for r in rr:\n                ms=matches(r,aci); a=float(r['eur_amount']); vals=[feval(f,a) for f in ms]\n                if not vals: continue\n                if mode=='sum': tot+=sum(vals)\n                elif mode=='avg': tot+=sum(vals)/len(vals)\n                else: tot+=min(vals)\n            line.append((aci,round(tot,4)))\n        print(sch,line)\nEOF", "description": "Compare sum/avg/min fee aggregations for Q2697"}}
