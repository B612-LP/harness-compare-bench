{"type": "tool_call", "callId": "call_01_ZvqO7VzQWFw7s80KH9HJ3388", "tool": "bash", "input": {"command": "python3 - <<'EOF'\nimport csv,collections\n# compute monthly stats for Martinis and Belles\nmerchants={'Martinis_Fine_Steakhouse','Belles_cookbook_store'}\nstats={}\nwith open('inputs/payments.csv') as f:\n    for r in csv.DictReader(f):\n        if r['merchant'] not in merchants: continue\n        d=int(r['day_of_year'])\n        # month from 2023 nonleap\n        import datetime\n        m=datetime.date(2023,1,1)+datetime.timedelta(days=d-1)\n        key=(r['merchant'],m.month)\n        s=stats.setdefault(key,{'n':0,'vol':0.0,'fraud_n':0,'fraud_vol':0.0,'ref':0})\n        a=float(r['eur_amount'])\n        s['n']+=1; s['vol']+=a\n        if r['has_fraudulent_dispute']=='True': s['fraud_n']+=1; s['fraud_vol']+=a\n        if r['is_refused_by_adyen']=='True': s['ref']+=1\nfor k in sorted(stats):\n    s=stats[k]\n    print(k, 'n',s['n'],'vol',round(s['vol'],2),'fraud_n',s['fraud_n'],'fraud_vol',round(s['fraud_vol'],2),'fraud_rate_vol',round(100*s['fraud_vol']/s['vol'],4),'fraud_rate_n',round(100*s['fraud_n']/s['n'],4))\nEOF", "description": "Monthly fraud stats for key merchants"}}
