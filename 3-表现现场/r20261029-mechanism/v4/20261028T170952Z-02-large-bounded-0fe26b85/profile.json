[
  {
    "id": "agent-default-model",
    "config": {
      "provider": "deepseek-official",
      "model": "deepseek-flash",
      "reasoningEffort": "low"
    }
  },
  {
    "id": "llm-deepseek",
    "config": {
      "reasoningEffort": "low",
      "maxTokens": 1024,
      "retryPolicy": {
        "mode": "normal",
        "maxRetries": 0
      }
