{"type": "tool_call", "callId": "call_01_nZGecl76uRWKXQnjTanN7279", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport json\nfees=json.load(open('inputs/fees.json'))\ndef wild(v): return v is None or v==[] or v==0 or v==0.0\ndef match(rule, **kw):\n    for k,v in kw.items():\n        rv=rule[k]\n        if rv is None or rv==[]: continue\n        if isinstance(rv,list):\n            if v not in rv: return False\n        else:\n            if rv!=v: return False\n    return True\n# Q1273\nsel=[r for r in fees if r['card_scheme']=='GlobalCard' and r['is_credit'] is not False]\nval=[r['fixed_amount']+r['rate']*10/10000 for r in sel]\nprint('Q1273 n',len(sel),'avg',sum(val)/len(val))\nprint(collections.Counter if False else '')\n# print selected\nfor r in sel[:20]: print(r['ID'],r['fixed_amount'],r['rate'],r['is_credit'],r['account_type'],r['aci'])\nPY", "description": "Compute Q1273 candidates"}}
