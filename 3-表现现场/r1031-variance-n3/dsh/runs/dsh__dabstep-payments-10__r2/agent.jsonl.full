{"type": "tool_call", "callId": "call_00_JtuIO7UObtKeqeKi1QSO8874", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport json,collections\nfees=json.load(open('inputs/fees.json'))\ndef match(r, **kw):\n    for k,v in kw.items():\n        rv=r[k]\n        if rv is None or rv==[]: continue\n        if isinstance(rv,list):\n            if v not in rv: return False\n        elif rv!=v: return False\n    return True\ndef avg(sel): return sum(r['fixed_amount']+r['rate']*10/10000 for r in sel)/len(sel) if sel else None\nfor cond in [dict(is_credit=True),dict(is_credit=None),dict()]:\n    sel=[r for r in fees if r['card_scheme']=='GlobalCard' and match(r,**cond) and (cond.get('is_credit','x')!='x' or r['is_credit'] is not False)]\n    print('1273 cond',cond,len(sel),avg(sel))\n# better variants\nfor label,sel in [\n ('credit true only',[r for r in fees if r['card_scheme']=='GlobalCard' and r['is_credit'] is True]),\n ('credit not false',[r for r in fees if r['card_scheme']=='GlobalCard' and r['is_credit'] is not False]),\n ('all globalcard',[r for r in fees if r['card_scheme']=='GlobalCard']),\n]:\n print(label,len(sel),avg(sel))\n# Q1305\nfor label,sel in [\n ('H+5812 all',[r for r in fees if r['card_scheme']=='GlobalCard' and match(r,account_type='H',merchant_category_code=5812)]),\n ('H+5812 credit',[r for r in fees if r['card_scheme']=='GlobalCard' and match(r,account_type='H',merchant_category_code=5812,is_credit=True)]),\n ('H+5812 notfalse',[r for r in fees if r['card_scheme']=='GlobalCard' and r['is_credit'] is not False and match(r,account_type='H',merchant_category_code=5812)]),\n]:\n print('1305',label,len(sel),avg(sel))\n for r in sel: print(' ',r['ID'],r['fixed_amount'],r['rate'],r['is_credit'],r['account_type'],r['merchant_category_code'],r['aci'])\nPY", "description": "Test fee filtering variants for Q1273/Q1305"}}
