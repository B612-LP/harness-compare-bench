{"type": "tool_call", "callId": "call_00_QE83NmQOJyWodrWaiLhO8270", "tool": "bash", "input": {"command": "cat > /tmp/test388g.py << 'PY'\nimport random, subprocess, bisect\n\ndef brute_seg(seg):\n    # max k smallest with k largest\n    n=len(seg)\n    ans=0\n    for k in range(0,n//2+1):\n        ok=True\n        for i in range(k):\n            if 2*seg[i] > seg[n-k+i]:\n                ok=False; break\n        if ok: ans=k\n    return ans\n\nfor t in range(500):\n    n=random.randint(2,12)\n    A=sorted(random.randint(1,40) for _ in range(n))\n    q=random.randint(1,15)\n    qs=[]; exp=[]\n    for _ in range(q):\n        L=random.randint(1,n-1); R=random.randint(L+1,n)\n        qs.append((L,R)); exp.append(brute_seg(A[L-1:R]))\n    inp=f\"{n}\\n{' '.join(map(str,A))}\\n{q}\\n\"+\"\".join(f\"{L} {R}\\n\" for L,R in qs)\n    out=subprocess.run(['python3','solutions/abc388_g.py'],input=inp.encode(),stdout=subprocess.PIPE).stdout.decode().split()\n    got=list(map(int,out))\n    if got!=exp:\n        print('Mismatch',n,A,qs,got,exp); print(inp); break\nelse:\n    print('all ok')\nPY\npython3 /tmp/test388g.py", "description": "Random brute-force test ABC388 G"}}
