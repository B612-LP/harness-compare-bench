{"type": "tool_call", "callId": "call_00_3Lo9dGynEk76JWavewtC8322", "tool": "bash", "input": {"command": "python3 - << 'PY'\nimport itertools, subprocess\nfrom collections import deque\n\ndef brute(N,P):\n    pairs=list(itertools.combinations(range(N),2))\n    E=len(pairs)\n    maxm=N*(N-1)//2\n    cnt=[0]*(maxm+1)\n    for mask in range(1<<E):\n        adj=[[] for _ in range(N)]\n        m=bin(mask).count('1')\n        for k,(u,v) in enumerate(pairs):\n            if mask>>k&1:\n                adj[u].append(v); adj[v].append(u)\n        seen=[False]*N; seen[0]=True; dq=deque([0]); c=1\n        while dq:\n            u=dq.popleft()\n            for v in adj[u]:\n                if not seen[v]: seen[v]=True;c+=1;dq.append(v)\n        if c!=N: continue\n        dist=[-1]*N; dist[0]=0; dq=deque([0])\n        while dq:\n            u=dq.popleft()\n            for v in adj[u]:\n                if dist[v]<0: dist[v]=dist[u]+1; dq.append(v)\n        ev=sum(1 for x in dist if x%2==0)\n        od=N-ev\n        if ev==od: cnt[m]+=1\n    return [cnt[m]%P for m in range(N-1,maxm+1)]\n\nfor N,P in [(2,100000007),(4,100000007),(6,100000007),(6,998244353)]:\n    inp=f'{N} {P}\\n'\n    r=subprocess.run(['python3','solutions/abc389_g.py'],input=inp,text=True,capture_output=True)\n    got=list(map(int,r.stdout.split()))\n    exp=brute(N,P)\n    print(N,P,'OK' if got==exp else 'FAIL',got,exp)\nPY", "description": "Brute-force validate abc389_g for small N"}}
