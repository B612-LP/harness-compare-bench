{"type": "tool_call", "callId": "call_00_pn9XEzAmKNG6n8zujYKp4867", "tool": "bash", "input": {"command": "python3 - <<'EOF'\nimport json, csv, collections\nfees=json.load(open('inputs/fees.json'))\n# Belles parameters\ndef mf(level, rule):\n    if rule is None: return True\n    if rule=='>8.3%': return level>8.3\n    if rule=='<7.2%': return level<7.2\n    lo,hi=rule[:-1].split('-');return float(lo.rstrip('%'))<=level<=float(hi.rstrip('%'))\ndef mv(v,rule):\n    if rule is None: return True\n    return {'>5m':v>5e6,'1m-5m':1e6<=v<=5e6,'100k-1m':1e5<=v<=1e6,'<100k':v<1e5}[rule]\ndef match(r,scheme,aci,credit,intra,cap='<3'):\n    if r['card_scheme']!=scheme: return False\n    if r['account_type'] and 'R' not in r['account_type']: return False\n    if r['capture_delay'] is not None and r['capture_delay']!=cap: return False\n    if not mf(10.313064352048135,r['monthly_fraud_level']): return False\n    if not mv(113260.42,r['monthly_volume']): return False\n    if r['merchant_category_code'] and 5942 not in r['merchant_category_code']: return False\n    if r['is_credit'] is not None and bool(r['is_credit'])!=credit: return False\n    if r['aci'] and aci not in r['aci']: return False\n    if r['intracountry'] is not None and bool(r['intracountry'])!=intra: return False\n    return True\nfor scheme in ['GlobalCard','NexPay','TransactPlus','SwiftCharge']:\n    print('\\n',scheme)\n    for aci in 'ABCDEFG':\n        rs=[r for r in fees if match(r,scheme,aci,True,False)]\n        print(aci, len(rs), [(r['ID'],r['fixed_amount'],r['rate'],r['capture_delay'],r['monthly_fraud_level'],r['monthly_volume']) for r in rs])\nEOF", "description": "Enumerate applicable rules by scheme and ACI for Belles"}}
