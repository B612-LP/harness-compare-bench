{"type": "tool_result", "callId": "call_01_ET_AdWhrLkBqL2niFlxdyBA2896", "status": "completed", "result": "<path>/Users/b612-lp/bench-workspaces/r1031/dsh/2/exercism-py-6/inputs/exercises/zipper/zipper_test.py</path>\n<type>file</type>\n<content>\n1: # These tests are auto-generated with test data from:\n2: # https://github.com/exercism/problem-specifications/tree/main/exercises/zipper/canonical-data.json\n3: # File last updated on 2023-07-19\n4: \n5: import unittest\n6: \n7: from zipper import (\n8:     Zipper,\n9: )\n10: \n11: \n12: class ZipperTest(unittest.TestCase):\n13:     def test_data_is_retained(self):\n14:         initial = {\n15:             \"value\": 1,\n16:             \"left\": {\n17:                 \"value\": 2,\n18:                 \"left\": None,\n19:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n20:             },\n21:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n22:         }\n23: \n24:         expected = {\n25:             \"value\": 1,\n26:             \"left\": {\n27:                 \"value\": 2,\n28:                 \"left\": None,\n29:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n30:             },\n31:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n32:         }\n33: \n34:         zipper = Zipper.from_tree(initial)\n35:         result = zipper.to_tree()\n36:         self.assertEqual(result, expected)\n37: \n38:     def test_left_right_and_value(self):\n39:         initial = {\n40:             \"value\": 1,\n41:             \"left\": {\n42:                 \"value\": 2,\n43:                 \"left\": None,\n44:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n45:             },\n46:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n47:         }\n48: \n49:         zipper = Zipper.from_tree(initial)\n50:         result = zipper.left().right().value()\n51:         self.assertEqual(result, 3)\n52: \n53:     def test_dead_end(self):\n54:         initial = {\n55:             \"value\": 1,\n56:             \"left\": {\n57:                 \"value\": 2,\n58:                 \"left\": None,\n59:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n60:             },\n61:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n62:         }\n63: \n64:         zipper = Zipper.from_tree(initial)\n65:         result = zipper.left().left()\n66:         self.assertIsNone(result)\n67: \n68:     def test_tree_from_deep_focus(self):\n69:         initial = {\n70:             \"value\": 1,\n71:             \"left\": {\n72:                 \"value\": 2,\n73:                 \"left\": None,\n74:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n75:             },\n76:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n77:         }\n78: \n79:         expected = {\n80:             \"value\": 1,\n81:             \"left\": {\n82:                 \"value\": 2,\n83:                 \"left\": None,\n84:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n85:             },\n86:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n87:         }\n88: \n89:         zipper = Zipper.from_tree(initial)\n90:         result = zipper.left().right().to_tree()\n91:         self.assertEqual(result, expected)\n92: \n93:     def test_traversing_up_from_top(self):\n94:         initial = {\n95:             \"value\": 1,\n96:             \"left\": {\n97:                 \"value\": 2,\n98:                 \"left\": None,\n99:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n100:             },\n101:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n102:         }\n103: \n104:         zipper = Zipper.from_tree(initial)\n105:         result = zipper.up()\n106:         self.assertIsNone(result)\n107: \n108:     def test_left_right_and_up(self):\n109:         initial = {\n110:             \"value\": 1,\n111:             \"left\": {\n112:                 \"value\": 2,\n113:                 \"left\": None,\n114:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n115:             },\n116:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n117:         }\n118: \n119:         zipper = Zipper.from_tree(initial)\n120:         result = zipper.left().up().right().up().left().right().value()\n121:         self.assertEqual(result, 3)\n122: \n123:     def test_test_ability_to_descend_multiple_levels_and_return(self):\n124:         initial = {\n125:             \"value\": 1,\n126:             \"left\": {\n127:                 \"value\": 2,\n128:                 \"left\": None,\n129:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n130:             },\n131:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n132:         }\n133: \n134:         zipper = Zipper.from_tree(initial)\n135:         result = zipper.left().right().up().up().value()\n136:         self.assertEqual(result, 1)\n137: \n138:     def test_set_value(self):\n139:         initial = {\n140:             \"value\": 1,\n141:             \"left\": {\n142:                 \"value\": 2,\n143:                 \"left\": None,\n144:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n145:             },\n146:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n147:         }\n148: \n149:         expected = {\n150:             \"value\": 1,\n151:             \"left\": {\n152:                 \"value\": 5,\n153:                 \"left\": None,\n154:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n155:             },\n156:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n157:         }\n158: \n159:         zipper = Zipper.from_tree(initial)\n160:         result = zipper.left().set_value(5).to_tree()\n161:         self.assertEqual(result, expected)\n162: \n163:     def test_set_value_after_traversing_up(self):\n164:         initial = {\n165:             \"value\": 1,\n166:             \"left\": {\n167:                 \"value\": 2,\n168:                 \"left\": None,\n169:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n170:             },\n171:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n172:         }\n173: \n174:         expected = {\n175:             \"value\": 1,\n176:             \"left\": {\n177:                 \"value\": 5,\n178:                 \"left\": None,\n179:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n180:             },\n181:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n182:         }\n183: \n184:         zipper = Zipper.from_tree(initial)\n185:         result = zipper.left().right().up().set_value(5).to_tree()\n186:         self.assertEqual(result, expected)\n187: \n188:     def test_set_left_with_leaf(self):\n189:         initial = {\n190:             \"value\": 1,\n191:             \"left\": {\n192:                 \"value\": 2,\n193:                 \"left\": None,\n194:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n195:             },\n196:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n197:         }\n198: \n199:         expected = {\n200:             \"value\": 1,\n201:             \"left\": {\n202:                 \"value\": 2,\n203:                 \"left\": {\"value\": 5, \"left\": None, \"right\": None},\n204:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n205:             },\n206:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n207:         }\n208: \n209:         zipper = Zipper.from_tree(initial)\n210:         result = (\n211:             zipper.left().set_left({\"value\": 5, \"left\": None, \"right\": None}).to_tree()\n212:         )\n213:         self.assertEqual(result, expected)\n214: \n215:     def test_set_right_with_null(self):\n216:         initial = {\n217:             \"value\": 1,\n218:             \"left\": {\n219:                 \"value\": 2,\n220:                 \"left\": None,\n221:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n222:             },\n223:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n224:         }\n225: \n226:         expected = {\n227:             \"value\": 1,\n228:             \"left\": {\"value\": 2, \"left\": None, \"right\": None},\n229:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n230:         }\n231: \n232:         zipper = Zipper.from_tree(initial)\n233:         result = zipper.left().set_right(None).to_tree()\n234:         self.assertEqual(result, expected)\n235: \n236:     def test_set_right_with_subtree(self):\n237:         initial = {\n238:             \"value\": 1,\n239:             \"left\": {\n240:                 \"value\": 2,\n241:                 \"left\": None,\n242:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n243:             },\n244:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n245:         }\n246: \n247:         expected = {\n248:             \"value\": 1,\n249:             \"left\": {\n250:                 \"value\": 2,\n251:                 \"left\": None,\n252:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n253:             },\n254:             \"right\": {\n255:                 \"value\": 6,\n256:                 \"left\": {\"value\": 7, \"left\": None, \"right\": None},\n257:                 \"right\": {\"value\": 8, \"left\": None, \"right\": None},\n258:             },\n259:         }\n260: \n261:         zipper = Zipper.from_tree(initial)\n262:         result = zipper.set_right(\n263:             {\n264:                 \"value\": 6,\n265:                 \"left\": {\"value\": 7, \"left\": None, \"right\": None},\n266:                 \"right\": {\"value\": 8, \"left\": None, \"right\": None},\n267:             }\n268:         ).to_tree()\n269:         self.assertEqual(result, expected)\n270: \n271:     def test_set_value_on_deep_focus(self):\n272:         initial = {\n273:             \"value\": 1,\n274:             \"left\": {\n275:                 \"value\": 2,\n276:                 \"left\": None,\n277:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n278:             },\n279:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n280:         }\n281: \n282:         expected = {\n283:             \"value\": 1,\n284:             \"left\": {\n285:                 \"value\": 2,\n286:                 \"left\": None,\n287:                 \"right\": {\"value\": 5, \"left\": None, \"right\": None},\n288:             },\n289:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n290:         }\n291: \n292:         zipper = Zipper.from_tree(initial)\n293:         result = zipper.left().right().set_value(5).to_tree()\n294:         self.assertEqual(result, expected)\n295: \n296:     def test_different_paths_to_same_zipper(self):\n297:         initial = {\n298:             \"value\": 1,\n299:             \"left\": {\n300:                 \"value\": 2,\n301:                 \"left\": None,\n302:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n303:             },\n304:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n305:         }\n306:         result = Zipper.from_tree(initial).left().up().right().to_tree()\n307: \n308:         final = {\n309:             \"value\": 1,\n310:             \"left\": {\n311:                 \"value\": 2,\n312:                 \"left\": None,\n313:                 \"right\": {\"value\": 3, \"left\": None, \"right\": None},\n314:             },\n315:             \"right\": {\"value\": 4, \"left\": None, \"right\": None},\n316:         }\n317:         expected = Zipper.from_tree(final).right().to_tree()\n318: \n319:         self.assertEqual(result, expected)\n\n(End of file - total 319 lines)\n</content>"}
