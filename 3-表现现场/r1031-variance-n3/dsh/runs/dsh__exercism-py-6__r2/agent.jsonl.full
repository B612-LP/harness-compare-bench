{"type": "tool_call", "callId": "call_02_uZjDMF8jlf1FtIkhNoBH5683", "tool": "write", "input": {"file_path": "/Users/b612-lp/bench-workspaces/r1031/dsh/2/exercism-py-6/inputs/exercises/forth/forth.py", "content": "import re\n\n\nclass StackUnderflowError(Exception):\n    pass\n\n\n_NUMBER = re.compile(r\"^-?\\d+$\")\n\n\ndef evaluate(input_data):\n    tokens = \" \".join(input_data).split()\n    custom = {}\n    stack = []\n\n    def underflow():\n        raise StackUnderflowError(\"Insufficient number of items in stack\")\n\n    def need(count):\n        if len(stack) < count:\n            underflow()\n\n    def binary(operation):\n        need(2)\n        b = stack.pop()\n        a = stack.pop()\n        stack.append(operation(a, b))\n\n    def divide(a, b):\n        if b == 0:\n            raise ZeroDivisionError(\"divide by zero\")\n        return int(a / b)\n\n    builtins = {\n        \"+\": lambda: binary(lambda a, b: a + b),\n        \"-\": lambda: binary(lambda a, b: a - b),\n        \"*\": lambda: binary(lambda a, b: a * b),\n        \"/\": lambda: binary(divide),\n        \"dup\": lambda: (need(1), stack.append(stack[-1])),\n        \"drop\": lambda: (need(1), stack.pop()),\n        \"swap\": lambda: _swap(),\n        \"over\": lambda: _over(),\n    }\n\n    def _swap():\n        need(2)\n        stack[-1], stack[-2] = stack[-2], stack[-1]\n\n    def _over():\n        need(2)\n        stack.append(stack[-2])\n\n    def execute(token):\n        token = token.lower()\n        if token in custom:\n            for part in custom[token]:\n                execute(part)\n        elif token in builtins:\n            builtins[token]()\n        elif _NUMBER.match(token):\n            stack.append(int(token))\n        else:\n            raise ValueError(\"undefined operation\")\n\n    i = 0\n    while i < len(tokens):\n        token = tokens[i]\n        if token == \":\":\n            if i + 1 >= len(tokens):\n                raise ValueError(\"illegal operation\")\n            name = tokens[i + 1].lower()\n            if _NUMBER.match(name) or name == \":\":\n                raise ValueError(\"illegal operation\")\n            i += 2\n            body = []\n            while i < len(tokens) and tokens[i] != \";\":\n                part = tokens[i].lower()\n                if part in custom:\n                    body.extend(custom[part])\n                elif part in builtins or _NUMBER.match(part):\n                    body.append(part)\n                else:\n                    raise ValueError(\"undefined operation\")\n                i += 1\n            if i >= len(tokens):\n                raise ValueError(\"undefined operation\")\n            custom[name] = body\n            i += 1\n        elif token == \";\":\n            raise ValueError(\"undefined operation\")\n        else:\n            execute(token)\n            i += 1\n\n    return stack\n"}}
