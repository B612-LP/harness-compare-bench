{"type": "tool_call", "callId": "call_00_5SGRkHWoMcZmLy1AXhfz2266", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport sqlite3\ncon=sqlite3.connect('inputs/db/california_schools.sqlite')\nc=con.cursor()\ndef q(label,sql):\n print('\\n##',label)\n for r in c.execute(sql): print(r)\n\nbase=\"\"\"select s.City, s.School, f.`NSLP Provision Status`, s.GSoffered,s.GSserved,f.`Low Grade`,f.`High Grade`,f.`School Type`\nfrom schools s join frpm f on s.CDSCode=f.CDSCode\nwhere s.Magnet=1 and f.`NSLP Provision Status`='Multiple Provision Types'\"\"\"\nq('all magnet multiple',base)\nq('GSoffered K-8',base+\" and s.GSoffered='K-8'\")\nq('GSserved K-8',base+\" and s.GSserved='K-8'\")\nq('frpm Low K High 8',base+\" and f.`Low Grade`='K' and f.`High Grade`='8'\")\nq('groups GSoffered', \"select City,count(*) from schools s join frpm f on s.CDSCode=f.CDSCode where s.Magnet=1 and f.`NSLP Provision Status`='Multiple Provision Types' and s.GSoffered='K-8' group by City\")\nq('groups GSserved', \"select City,count(*) from schools s join frpm f on s.CDSCode=f.CDSCode where s.Magnet=1 and f.`NSLP Provision Status`='Multiple Provision Types' and s.GSserved='K-8' group by City\")\nPY", "description": "Explore q83 grade span variants"}}
