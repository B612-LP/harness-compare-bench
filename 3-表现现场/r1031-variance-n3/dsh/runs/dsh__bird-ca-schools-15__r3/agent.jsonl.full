 schools s\nJOIN satscores t ON s.CDSCode = t.cds\nJOIN frpm f ON s.CDSCode = f.CDSCode\nWHERE s.District LIKE 'Riverside%'\n  AND t.AvgScrMath > 400''',\n26: '''SELECT f.\"School Name\", s.Street, s.City, s.State, s.Zip\nFROM frpm f\nJOIN schools s ON f.CDSCode = s.CDSCode\nWHERE f.\"County Name\" = 'Monterey'\n  AND f.\"School Type\" = 'High Schools (Public)'\n  AND f.\"FRPM Count (Ages 5-17)\" > 800''',\n27: '''SELECT s.School, t.AvgScrWrite, s.Phone\nFROM schools s\nLEFT JOIN satscores t ON s.CDSCode = t.cds\nWHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01' ''',\n31: '''SELECT f.\"Free Meal Count (K-12)\" / f.\"Enrollment (K-12)\" AS ratio\nFROM frpm f\nWHERE f.\"Enrollment (K-12)\" IS NOT NULL\nORDER BY f.\"Enrollment (K-12)\" DESC\nLIMIT 2 OFFSET 9''',\n5: '''SELECT COUNT(*) AS count\nFROM satscores t\nJOIN schools s ON t.cds = s.CDSCode\nWHERE t.AvgScrMath > 400\n  AND s.Virtual = 'F' ''',\n11: '''SELECT CDSCode\nFROM frpm\nWHERE (\"Enrollment (K-12)\" + \"Enrollment (Ages 5-17)\") > 500''',\n17: '''SELECT s.CharterNum, t.AvgScrWrite,\n       RANK() OVER (ORDER BY t.AvgScrWrite DESC) AS WritingScoreRank\nFROM satscores t\nJOIN schools s ON t.cds = s.CDSCode\nWHERE t.AvgScrWrite > 499\n  AND s.CharterNum IS NOT NULL''',\n}\n# order as questions\nqs=json.load(open('inputs/questions.json'))\nassert set(answers)=={q['question_id'] for q in qs}, (set(answers), {q['question_id'] for q in qs})\nwith open('answers.jsonl','w') as fh:\n    for q in qs:\n        fh.write(json.dumps({'question_id':q['question_id'],'sql':answers[q['question_id']]},ensure_ascii=False)+'\\n')\nprint('wrote',len(qs))\nPY\npython3 - <<'PY'\nimport json,sqlite3\ncon=sqlite3.connect('inputs/db/california_schools.sqlite')\nfor line in open('answers.jsonl'):\n d=json.loads(line)\n cur=con.execute(d['sql'])\n rows=cur.fetchall()\n print(d['question_id'], 'rows=',len(rows), 'cols=',len(rows[0]) if rows else len(cur.description or []), 'sample=',rows[:2])\nPY", "description": "Write answers.jsonl and execute all SQL"}}
