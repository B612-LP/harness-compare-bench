{"type": "tool_call", "callId": "call_00_56eyDiQeiCyqaLwIppBQ9124", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport sqlite3\ncon=sqlite3.connect('inputs/db/california_schools.sqlite'); c=con.cursor()\ndef run(label,q):\n    rows=c.execute(q).fetchall(); print('\\n###',label,len(rows))\n    for r in rows[:40]: print(r)\nrun('riverside districts','''SELECT f.`District Name`,COUNT(*),AVG(t.AvgScrMath),SUM(t.AvgScrMath),SUM(t.AvgScrMath)*1.0/COUNT(*) FROM frpm f JOIN satscores t ON f.CDSCode=t.cds WHERE f.`District Name` LIKE 'Riverside%' GROUP BY f.`District Name`''')\nrun('rtype counts','''SELECT rtype,COUNT(*),MAX(NumGE1500),MAX(CASE WHEN rtype='S' THEN NumGE1500 END) FROM satscores GROUP BY rtype''')\nrun('school max GE','''SELECT t.cds,t.sname,t.NumGE1500,s.School,s.AdmFName1,s.AdmLName1 FROM satscores t JOIN schools s ON t.cds=s.CDSCode WHERE t.rtype='S' ORDER BY t.NumGE1500 DESC LIMIT 5''')\nrun('all max GE','''SELECT t.cds,t.sname,t.NumGE1500,t.rtype,s.School,s.AdmFName1,s.AdmLName1 FROM satscores t JOIN schools s ON t.cds=s.CDSCode ORDER BY t.NumGE1500 DESC LIMIT 8''')\nrun('q83 mag k8 all','''SELECT s.City,s.School,s.GSoffered,s.GSserved,f.`Low Grade`,f.`High Grade`,f.`NSLP Provision Status` FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.Magnet=1 AND (s.GSoffered='K-8' OR s.GSserved='K-8' OR (f.`Low Grade`='K' AND f.`High Grade`='8'))''')\nrun('q62 min ratios','''SELECT f.`Free Meal Count (K-12)`,f.`Enrollment (K-12)`,f.`Free Meal Count (K-12)`*100.0/f.`Enrollment (K-12)` FROM schools s JOIN frpm f ON s.CDSCode=f.CDSCode WHERE s.County='Los Angeles' AND s.Charter=0 ORDER BY 3 LIMIT 10''')\nPY", "description": "Inspect q25, q36, q83, q62 details"}}
