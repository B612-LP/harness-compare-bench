{"type": "tool_call", "callId": "call_00_BNMBaCN2kknH6qjD4J3r4674", "tool": "bash", "input": {"command": "python3 - <<'PY'\nimport sqlite3\ncon=sqlite3.connect('inputs/db/california_schools.sqlite'); c=con.cursor()\nqs={\n'a':\"SELECT COUNT(*) FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\",\n'b':\"SELECT COUNT(*) FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE CAST(strftime('%Y',s.OpenDate) AS INT) > 1991 OR CAST(strftime('%Y',s.ClosedDate) AS INT) < 2000\",\n'c':\"SELECT COUNT(*) FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE s.OpenDate >= '1991-01-01' OR s.ClosedDate < '2000-01-01'\",\n'd':\"SELECT COUNT(*) FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE s.OpenDate > '1991' OR s.ClosedDate < '2000'\",\n'e':\"SELECT COUNT(*) FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE s.OpenDate BETWEEN '1991-01-01' AND '1991-12-31'\",\n}\nfor k,q in qs.items(): print(k,c.execute(q).fetchone())\n# compare a vs b row sets\na=set(c.execute(\"SELECT s.CDSCode FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\").fetchall())\nb=set(c.execute(\"SELECT s.CDSCode FROM schools s LEFT JOIN satscores t ON s.CDSCode=t.cds WHERE CAST(strftime('%Y',s.OpenDate) AS INT) > 1991 OR CAST(strftime('%Y',s.ClosedDate) AS INT) < 2000\").fetchall())\nprint('a-b',len(a-b),'b-a',len(b-a))\nPY", "description": "Compare date condition variants for q27"}}
