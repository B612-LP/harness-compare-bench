Name`, s.Street, s.City, s.State, s.Zip FROM frpm f JOIN schools s ON f.CDSCode = s.CDSCode WHERE f.`County Name` = 'Monterey' AND f.`FRPM Count (Ages 5-17)` > 800 AND f.`School Type` = 'High Schools (Public)'\"),\n(27, \"SELECT s.School, t.AvgScrWrite, s.Phone FROM schools s LEFT JOIN satscores t ON s.CDSCode = t.cds WHERE s.OpenDate > '1991-12-31' OR s.ClosedDate < '2000-01-01'\"),\n(31, \"SELECT f.`Free Meal Count (K-12)` * 1.0 / f.`Enrollment (K-12)` FROM frpm f ORDER BY f.`Enrollment (K-12)` DESC LIMIT 2 OFFSET 9\"),\n(5, \"SELECT COUNT(*) FROM satscores t JOIN schools s ON t.cds = s.CDSCode WHERE t.AvgScrMath > 400 AND s.Virtual = 'F'\"),\n(11, \"SELECT CDSCode FROM frpm WHERE `Enrollment (K-12)` + `Enrollment (Ages 5-17)` > 500\"),\n(17, \"SELECT s.CharterNum, t.AvgScrWrite, RANK() OVER (ORDER BY t.AvgScrWrite DESC) AS WritingScoreRank FROM satscores t JOIN schools s ON t.cds = s.CDSCode WHERE t.AvgScrWrite > 499 AND s.CharterNum IS NOT NULL ORDER BY t.AvgScrWrite DESC\"),\n]\nwith open('answers.jsonl','w',encoding='utf-8') as out:\n    for qid, sql in answers:\n        out.write(json.dumps({\"question_id\": qid, \"sql\": sql}, ensure_ascii=False)+\"\\n\")\nprint('wrote', len(answers))\nPY\npython3 - <<'PY'\nimport json, sqlite3\nqs=json.load(open('inputs/questions.json'))\nqmap={q['question_id']:q for q in qs}\nlines=[json.loads(x) for x in open('answers.jsonl') if x.strip()]\nprint('lines',len(lines),'unique ids',len({x['question_id'] for x in lines}))\nprint('missing', set(qmap)-{x['question_id'] for x in lines})\ncon=sqlite3.connect('inputs/db/california_schools.sqlite'); c=con.cursor()\nfor x in lines:\n    qid=x['question_id']; sql=x['sql']\n    try:\n        rows=c.execute(sql).fetchall()\n        cols=len(c.description)\n        exp=len(qmap[qid]['answer_columns'])\n        print(qid,'rows',len(rows),'cols',cols,'expected',exp,'OK' if cols==exp else 'MISMATCH', 'first', rows[0] if rows else None)\n    except Exception as e:\n        print(qid,'ERROR',e)\nPY", "description": "Write and validate answers.jsonl"}}
